@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Edit Product</h2>

    <input type="hidden" id="txtId" />

    <div class="mb-3">
        <label>Product Name</label>
        <input type="text" id="txtName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input type="number" id="txtPrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Quantity</label>
        <input type="number" id="txtQuantity" class="form-control" />
    </div>

    <button type="button" id="btnUpdate" class="btn btn-primary">
        Update Product
    </button>

    <a href="/Product/Index" class="btn btn-secondary">
        Back
    </a>

</div>

@section Scripts {

    <script>

        // Get Product ID from URL
        var id = new URLSearchParams(window.location.search).get("id");

        // Fetch existing product data
        $.ajax({

            url: "/api/ProductApi/" + id,
            type: "GET",

            success: function(product) {

                $("#txtId").val(product.productId);
                $("#txtName").val(product.productName);
                $("#txtPrice").val(product.price);
                $("#txtQuantity").val(product.quantity);

            },

            error: function() {
                alert("Unable to fetch product");
            }

        });


        // Update product
        $("#btnUpdate").click(function() {

            var product = {

                ProductId: parseInt($("#txtId").val()),
                ProductName: $("#txtName").val(),
                Price: parseFloat($("#txtPrice").val()),
                Quantity: parseInt($("#txtQuantity").val())

            };

            $.ajax({

                url: "/api/ProductApi/" + id,
                type: "PUT",

                contentType: "application/json",

                data: JSON.stringify(product),

                success: function(response) {

                    alert(response.message);

                    window.location.href = "/Product/ProductList";
                },

                error: function() {
                    alert("Unable to update product");
                }

            });

        });

    </script>

}