@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Add Product</h2>

    <div class="mb-3">
        <label>Product Name</label>
        <input type="text" id="txtName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input type="number" id="txtPrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Quantity</label>
        <input type="number" id="txtQuantity" class="form-control" />
    </div>

    <button type="button" id="btnSave" class="btn btn-primary">
        Save Product
    </button>

    <a href="/Product/Index" class="btn btn-secondary">
        Back
    </a>

</div>

@section Scripts {

    <script>

        $("#btnSave").click(function() {

            // Get input values
            var name = $("#txtName").val();
            var price = $("#txtPrice").val();
            var quantity = $("#txtQuantity").val();

            // Create product object
            var product = {
                ProductName: name,
                Price: parseFloat(price),
                Quantity: parseInt(quantity)
            };

            // Call Add Product API
            $.ajax({

                url: "/api/ProductApi",
                type: "POST",

                contentType: "application/json",

                data: JSON.stringify(product),

                success: function(response) {

                    alert(response.message);

                    window.location.href = "/Product/ProductList";
                },

                error: function() {
                    alert("Unable to add product");
                }

            });

        });

    </script>

}